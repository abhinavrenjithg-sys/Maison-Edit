# Which AI makes the "See it on me" photo:
#   free   = OOTDiffusion on Hugging Face (no cost; changes the top and skirt)
#   gemini = Google Gemini (paid, needs billing; changes the whole outfit)
AI_PROVIDER=free

# Free: a Hugging Face access token gives a much bigger daily GPU allowance.
# Make one (free account, no card) at https://huggingface.co/settings/tokens  (type: Read)
HF_TOKEN=

# Gemini: key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Optional, for testing against a mock server
# GEMINI_API_BASE=http://localhost:8098
